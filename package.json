{
  "name": "yaml-to-json-core",
  "version": "0.1.0",
  "description": "YAML ⇄ JSON conversion with human-readable errors and YAML 1.1 vs 1.2 (Norway problem) warnings — the engine behind yamltojsonfree.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "esbuild src/convert.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.cache/convert.test.mjs --log-level=warning && node .cache/convert.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["yaml", "json", "yaml-to-json", "json-to-yaml", "converter", "yaml-validator", "yaml-formatter", "norway-problem", "yaml-1.1", "yaml-1.2", "js-yaml", "kubernetes"],
  "homepage": "https://yamltojsonfree.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/free-micro-tools/yaml-to-json-core.git"
  },
  "bugs": {
    "url": "https://github.com/free-micro-tools/yaml-to-json-core/issues"
  },
  "author": "yamltojsonfree (https://yamltojsonfree.com/)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^5.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
